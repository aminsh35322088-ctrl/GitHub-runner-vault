{
  "name": "runner-vault",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter runner-vault-app test && node --test client/vault.test.mjs",
    "build": "pnpm --filter runner-vault-app build",
    "deploy": "node scripts/deploy.mjs",
    "validate": "pnpm typecheck && pnpm test && pnpm build",
    "vault:deploy": "node scripts/deploy.mjs"
  },
  "packageManager": "pnpm@12.16.1"
}
