{
  "name": "runner-vault",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "embed-schema": "pnpm --filter runner-vault-app embed-schema",
    "test": "pnpm --filter runner-vault-app test && node --test client/vault.test.mjs",
    "build": "pnpm --filter runner-vault-app build",
    "validate": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && pnpm --filter runner-vault-app exec wrangler deploy"
  },
  "packageManager": "pnpm@12.16.1"
}
