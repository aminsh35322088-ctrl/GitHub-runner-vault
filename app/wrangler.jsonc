{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runner-vault",
  "compatibility_date": "2026-10-31",
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/app.tsx",
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  // Deploy Button provisions D1 automatically; scripts/deploy.mjs resolves or creates it
  // for Git-connected builds and Wrangler CLI deployments before `wrangler deploy`.
  "d1_databases": [
    { "binding": "DB", "database_name": "runner-vault-db",
      "database_id": "392ce52e-e166-4db7-8106-b87dd14af345"}
  ],
  "vars": {},
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
