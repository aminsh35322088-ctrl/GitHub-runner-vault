{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runner-vault",
  "compatibility_date": "2026-10-31",
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/app.tsx",
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  // Created automatically on deploy (Deploy to Cloudflare button or `wrangler deploy`).
  // The Worker creates its own tables on first request; no migration step.
  "d1_databases": [
    { "binding": "DB", "database_name": "runner-vault-db" }
  ],
  "vars": {}
}
