{
  "name": "runner-vault-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Runner credential vault Worker (GitHub login, owner only)",
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.0-beta.4",
    "better-auth-drizzle-adapter": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "db": "workspace:^",
    "drizzle-orm": "1.0.0-rc.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spiceflow": "1.26.0-rsc.18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Any random string used to sign auth sessions and cookies. No length or format requirement. Generate with `openssl rand -base64 32`."
      },
      "ENCRYPTION_KEY": {
        "description": "Required. Exactly 32 random bytes, base64-encoded (44 characters), used for AES-256-GCM encryption of credentials at rest. Never derive it from BETTER_AUTH_SECRET. Back it up securely; rotating it requires an explicit credential re-encryption migration. Generate with openssl rand -base64 32."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "blake3-wasm": "2.1.5",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
