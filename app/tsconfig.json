{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "@cloudflare/vitest-plugin/types"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": [
      "workerd"
    ],
    "paths": {
      "sigillo-app/src/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "worker-configuration.d.ts"
  ]
}
